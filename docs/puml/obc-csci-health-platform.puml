@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "Health Monitoring (Platform) CSCI" as HM #EAF2FB {
  component "Watchdog CSC" as WD
  component "Health Monitor CSC" as HMON
}

package "DataBase CSCI — RTOS half" as DBRT {
  database "Data Buffer CSC" as DBUF #F0F0F0
  database "Configurations CSC" as CFG #F0F0F0
  database "Parameter Database CSC" as PDB #F0F0F0
}
package "Scheduling CSCI" as SCHED {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS #F0F0F0
}
package "FDIR CSCI" as FDIR {
  component "Operational State CSC" as STATES #F0F0F0
}
package "AOCS CSCI" as AOCS {
  component "Kalman Filter CSC" as FILTER #F0F0F0
}
package "Linux domain" as LINDOM {
  component "Payload Software CSCI" as PAY #F0F0F0
}
HMON --> WD : HMS kick

CFG --> HMON : Monitor/Alarm\nconfigurations
PDB --> HMON : current values
CCSDS --> HMON : TC
HMON --> DBUF : TM
HMON --> STATES : events
FILTER --> WD : AOCS kick
STATES --> WD : FDIR kick
STATES ..> PAY : platform state

@enduml

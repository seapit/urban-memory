@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "Scheduling CSCI" as SCHED #EAF2FB {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS
  component "Downlink Scheduler CSC" as DLSCHED
}

package "TTC CSCI" as TTC {
  component "Encryption CSC" as ENC #F0F0F0
}
package "DataBase CSCI — RTOS half" as DBRT {
  database "Data Buffer CSC" as DBUF #F0F0F0
  database "Configurations CSC" as CFG #F0F0F0
}
package "FDIR CSCI" as FDIR {
  component "Operational State CSC" as STATES #F0F0F0
}
package "Health Monitoring (Platform) CSCI" as HM {
  component "Health Monitor CSC" as HMON #F0F0F0
}
package "Linux domain" as LINDOM {
  component "Payload Software CSCI" as PAY #F0F0F0
}

ENC --> CCSDS : TC in (decrypted)
DLSCHED --> ENC : downlink data
DLSCHED --> DBUF : Scheduled Transmission\nCommand
DBUF --> DLSCHED : Buffered\nTM/data
CCSDS --> CFG : Updates to\nconfigurations
CCSDS --> STATES : TC\noperator commanded mode
CCSDS --> HMON : TC
CCSDS ..> PAY : TC
@enduml

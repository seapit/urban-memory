@startuml
' Scheduling CSCI — the CSCI in full, with every relation that crosses its boundary.
' Everything drawn in grey is context: it is shown only far enough to say what
' this CSCI talks to. The whole picture is in obc-csci-full.puml.
' GENERATED from obc-csci-full.puml — edit that file, then re-run split.py.

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

' ---------------------------------------------- the CSCI under view
package "Scheduling CSCI" as SCHED #EAF2FB {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS
  component "Downlink Scheduler CSC" as DLSCHED
}

' ---------------------------------------------- context only
package "TTC CSCI" as TTC {
  component "Encryption CSC" as ENC #F0F0F0
}
package "DataBase CSCI — RTOS half" as DBRT {
  database "Data Buffer CSC" as DBUF #F0F0F0
}
package "Non-volatile & mass storage" as STORE {
  database "MRAM" as MRAM #F0F0F0
}
package "Health Monitoring (Platform) CSCI" as HM {
  component "Health Monitor CSC" as HMON #F0F0F0
}
package "AOCS CSCI" as AOCS {
  component "Kalman Filter CSC" as FILTER #F0F0F0
}
package "Linux domain" as LINDOM {
  component "Health Monitoring (Payload) CSCI" as PHM #F0F0F0
  component "Payload Software CSCI" as PAY #F0F0F0
}
package "I/O interfaces" as IFACE {
  component "QSPI" as QSPI #F0F0F0
}
component "RTOS domain" as RTOSDOM #F0F0F0

' ---------------------------------------------- across its boundary
ENC <--> CCSDS : TC in (decrypted) /\nTM frames out
DLSCHED --> ENC : downlink stream,\ntransmitted by class
CCSDS --> DBUF : TM from every producer,\nqueued by class
DLSCHED --> DBUF : drain request\n(a scheduled command)
DBUF --> DLSCHED : queued TM,\nhighest class first
CCSDS <--> MRAM : command schedule and\nmission plan are MRAM-resident
HMON <--> CCSDS : TC — housekeeping, limits, events /\nTM — class 1 events, class 2 housekeeping
FILTER --> CCSDS : TM — attitude solution
PHM ..> CCSDS : payload housekeeping TM —\nqueued as class 2, not class 3
CCSDS <..> PAY : TC / TM (classes 3, 4, 5)
MRAM <--> QSPI : MRAM is reached over QSPI
QSPI --> RTOSDOM : boot images — primary ->\nsecondary -> golden, then Platform Only

@enduml

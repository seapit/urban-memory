@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "AOCS CSCI" as AOCS #EAF2FB {
  component "Kalman Filter CSC" as FILTER
  component "Satellite Orientation CSC" as SATORIENT
  component "Motor Controller CSC" as MOT
}

package "DataBase CSCI — RTOS half" as DBRT {
  database "Data Buffer CSC" as DBUF #F0F0F0
  database "Configurations CSC" as CFG #F0F0F0
  database "Parameter Database CSC" as PDB #F0F0F0
}
package "Health Monitoring (Platform) CSCI" as HM {
  component "Watchdog CSC" as WD #F0F0F0
}
package "FDIR CSCI" as FDIR {
  component "Operational State CSC" as STATES #F0F0F0
}
package "I/O interfaces" as IFACE {
  component "CAN" as CAN #F0F0F0
}
package "DataBase CSCI (Linux)" as DBLX {
  component "MetaData CSC" as META #F0F0F0
}

FILTER --> SATORIENT : PVT propagation
SATORIENT --> MOT : commanded\norientation

CFG --> FILTER : configurations
FILTER --> PDB : PVT/attitude\ndata
FILTER --> WD : AOCS kick
STATES --> SATORIENT : Orientation\nTarget
DBUF --> FILTER : PVT data
MOT --> CAN : commands
FILTER --> DBUF : TM (PVT data)
FILTER ..> META : TM (PVT data)\nduring captures

@enduml

@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "FDIR CSCI" as FDIR #EAF2FB {
  component "Boot CSC" as BOOT
  component "Operational State CSC" as STATES
  component "Power & Payload Control CSC" as PPC
}

package "DataBase CSCI — RTOS half" as DBRT {
  database "Configurations CSC" as CFG #F0F0F0
}
package "Scheduling CSCI" as SCHED {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS #F0F0F0
}
package "Health Monitoring (Platform) CSCI" as HM {
  component "Health Monitor CSC" as HMON #F0F0F0
  component "Watchdog CSC" as WD #F0F0F0
}
package "I/O interfaces" as IFACE {
  component "Commandable Power Delivery Unit" as PDUIF #F0F0F0
}
package "AOCS CSCI" as AOCS {
  component "Satellite Orientation CSC" as SATORIENT #F0F0F0
}
package "Linux domain" as LINDOM {
  component "Payload Software CSCI" as PAY #F0F0F0
}
BOOT --> STATES : Linux bring-up result
STATES --> PPC : transition actions

CFG --> STATES : configurations
CCSDS --> STATES : TC\noperator commanded mode
HMON --> STATES : events
STATES --> WD : FDIR kick
PPC --> PDUIF : power switching commands
STATES --> SATORIENT : Orientation\nTargets
PPC ..> PAY : payload shutdown
STATES ..> PAY : platform state
BOOT ..> LINDOM : Linux boot command

@enduml

@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

component "Payload Software CSCI" as PAY #EAF2FB

package "Linux domain" as LINDOM {
  component "Health Monitoring (Payload) CSCI" as PHM #F0F0F0
}
package "DataBase CSCI (Linux)" as DBLX {
  component "Compression CSC" as COMP #F0F0F0
}
package "Scheduling CSCI" as SCHED {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS #F0F0F0
}
package "FDIR CSCI" as FDIR {
  component "Power & Payload Control CSC" as PPC #F0F0F0
  component "Operational State CSC" as STATES #F0F0F0
}

PAY --> PHM : payload health status
PAY --> COMP : images (class 4)
CCSDS ..> PAY : TC
PPC ..> PAY : payload shutdown
STATES ..> PAY : platform state

@enduml

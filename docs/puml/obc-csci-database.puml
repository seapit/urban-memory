@startuml
' DataBase CSCI — the CSCI in full, with every relation that crosses its boundary.
' Everything drawn in grey is context: it is shown only far enough to say what
' this CSCI talks to. The whole picture is in obc-csci-full.puml.
' GENERATED from obc-csci-full.puml — edit that file, then re-run split.py.

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

' ---------------------------------------------- the CSCI under view
package "DataBase CSCI — RTOS half" as DBRT #EAF2FB {
  database "Data Buffer CSC" as DBUF
  database "Parameter Database CSC" as PDB
  database "Configurations CSC" as CFG
}
package "DataBase CSCI (Linux)" as DBLX #EAF2FB {
  component "Compression CSC" as COMP
  component "MetaData CSC" as META
}

' ---------------------------------------------- context only
package "Scheduling CSCI" as SCHED {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS #F0F0F0
  component "Downlink Scheduler CSC" as DLSCHED #F0F0F0
}
package "FDIR CSCI" as FDIR {
  component "States CSC" as STATES #F0F0F0
}
package "AOCS CSCI" as AOCS {
  component "Kalman Filter CSC" as FILTER #F0F0F0
}
package "Health Monitoring (Platform) CSCI" as HM {
  component "Health Monitor CSC" as HMON #F0F0F0
}
package "Sensor Service CSCI" as SENS {
  component "Sensor Polling CSC" as POLL #F0F0F0
}
package "Non-volatile & mass storage" as STORE {
  database "Mass Memory" as MASS #F0F0F0
  database "MRAM" as MRAM #F0F0F0
}
package "I/O interfaces" as IFACE {
  component "DDR (ECC)" as DDRIF #F0F0F0
  component "QSPI" as QSPI #F0F0F0
}
package "Linux domain" as LINDOM {
  component "Payload Software CSCI" as PAY #F0F0F0
}
package "Platform hardware" as PHW {
  component "DDR + ECC" as DDR #F0F0F0
}
component "RTOS domain" as RTOSDOM #F0F0F0

' ---------------------------------------------- inside the CSCI
COMP --> META : checksums (3),\ncapture time and position (5)

' ---------------------------------------------- across its boundary
CCSDS --> DBUF : TM from every producer,\nqueued by class
DLSCHED --> DBUF : drain request\n(a scheduled command)
DBUF --> DLSCHED : queued TM,\nhighest class first
CFG --> STATES : transition table,\nboot counters
CFG --> FILTER : gains, limits,\npropagation bound
HMON --> PDB : current values
PDB --> HMON : periodic sample ->\nhousekeeping packet
FILTER --> PDB : attitude solution
POLL --> PDB : sensor samples
DBUF <--> MASS : backing store for\nthe downlink queue
DBUF <--> MRAM : class 1 events survive\nthe reset they describe
CFG <--> MRAM : configuration &\npersistent state
PDB <--> DDRIF : the current-value table\nlives in DDR
PAY --> COMP : raw frames (class 4)
FILTER ..> META : attitude / geolocation at capture
DBLX ..> DBUF : class 3, 4 and 5 payload data\ninto the downlink queue
MRAM <--> QSPI : MRAM is reached over QSPI
DDR <--> DDRIF : DDR bus
QSPI --> RTOSDOM : boot images — primary ->\nsecondary -> golden, then Platform Only

@enduml

@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "DataBase CSCI — RTOS half" as DBRT #EAF2FB {
  database "Data Buffer CSC" as DBUF
  database "Parameter Database CSC" as PDB
  database "Configurations CSC" as CFG
}
package "DataBase CSCI (Linux)" as DBLX #EAF2FB {
  component "Compression CSC" as COMP
  component "MetaData CSC" as META
}

package "Scheduling CSCI" as SCHED {
  component "CCSDS / PUS Dispatcher CSC" as CCSDS #F0F0F0
  component "Downlink Scheduler CSC" as DLSCHED #F0F0F0
}
package "FDIR CSCI" as FDIR {
  component "Operational State CSC" as STATES #F0F0F0
}
package "AOCS CSCI" as AOCS {
  component "Kalman Filter CSC" as FILTER #F0F0F0
}
package "Health Monitoring (Platform) CSCI" as HM {
  component "Health Monitor CSC" as HMON #F0F0F0
}
package "Sensor Service CSCI" as SENS {
  component "Sensor Polling CSC" as POLL #F0F0F0
}
package "Linux domain" as LINDOM {
  component "Payload Software CSCI" as PAY #F0F0F0
  component "Health Monitoring (Payload) CSCI" as PHM #F0F0F0
}

COMP --> META : checksums,\nPVT data at capture

FILTER -[#blue]-> DBUF : TM (PVT data)
HMON ..> DBUF : TM
PHM ..> DBUF : payload TM
DLSCHED ..> DBUF : Scheduled\ntransmission data
DBUF --> DLSCHED : queued TM,\nhighest class first
CCSDS --> CFG : Updates to\nconfigurations
CFG --> STATES : transition table,\nboot counters
CFG -[#blue]-> FILTER : configurations
CFG --> HMON : Monitor/Alarm\nconfigurations
PDB ..> HMON : periodic sample ->\nhousekeeping packet
FILTER -[#blue]-> PDB : Satellite Orientation
POLL -[#green]-> DBUF : TM to\nping-pong buffer
DBUF -[#blue]-> FILTER : TM from\n ping-pong buffer
POLL -[#green]-> PDB : sensor samples
PAY --> COMP : images
FILTER .[#blue].> META : TM (PVT data)\nduring captures
DBLX ..> DBUF : Payload TM and Data\n(classes 3/4/5)

@enduml

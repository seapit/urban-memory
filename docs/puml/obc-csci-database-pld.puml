@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 58
skinparam defaultFontSize 12
skinparam wrapWidth 240
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #777777
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

package "DataBase CSCI (Linux)" as DBLX #EAF2FB {
  component "Compression CSC" as COMP
  component "MetaData CSC" as META
}

package "Linux domain" as LINDOM {
  component "Payload Software CSCI" as PAY #F0F0F0
}
package "AOCS CSCI" as AOCS {
  component "Kalman Filter CSC" as FILTER #F0F0F0
}
package "DataBase CSCI — RTOS half" as DBRT {
  database "Data Buffer CSC" as DBUF #F0F0F0
}

COMP --> META : checksums,\nPVT data at capture

PAY --> COMP : images
FILTER .[#blue].> META : TM (PVT data)\nduring captures
DBLX ..> DBUF : Payload TM and Data\n(classes 3/4/5)

@enduml
